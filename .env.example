# --- Obrigatório ---
ANTHROPIC_API_KEY=sk-ant-...
# Provedor compatível (ex.: KPA Labz): coloque a URL base dele e a chave dele acima
ANTHROPIC_BASE_URL=
# Modelo (troque se o provedor não tiver este)
ANTHROPIC_MODEL=claude-opus-5-5
# auto = tenta a busca da Anthropic e, se o provedor recusar, usa a busca própria
MODO_COMPATIVEL=auto
TELEGRAM_BOT_TOKEN=123456:ABC...          # crie com o @BotFather no Telegram
# IDs do Telegram que podem usar o bot (separados por vírgula). Descubra o seu com o @userinfobot
TELEGRAM_ALLOWED_USERS=123456789

# --- Opcional: Apify (comentários do Instagram/TikTok e Biblioteca de Anúncios) ---
APIFY_TOKEN=

# --- Opcional: busca no Google (Serper.dev, 2.500 buscas grátis para começar) ---
SERPER_API_KEY=

# --- Opcional: "comente QUERO" nos SEUS posts/anúncios (Meta Graph API) ---
META_VERIFY_TOKEN=uma-frase-secreta-qualquer
META_APP_SECRET=
META_PAGE_ACCESS_TOKEN=
META_PAGE_ID=
META_IG_USER_ID=
AUTO_REPLY_KEYWORDS=quero,eu quero,link,preço,valor
AUTO_REPLY_DM=Oi! Aqui está o link com seu desconto: {link}
AUTO_REPLY_PUBLIC=Te chamei no direct! 💌
AUTO_REPLY_LINK=https://seu-checkout.com/produto?cupom=QUERO10

# --- Opcional: ponte com a extensão do Chrome ---
# Ligue a "Publicação na Web" na hospedagem e use a porta que ela indicar (na Shard Cloud: 80)
WEB_ATIVO=
URL_PUBLICA=https://seu-app.exemplo.com

# --- Ajustes ---
TIMEZONE=America/Sao_Paulo
DIGEST_HOUR=7
DB_PATH=leadhunter.db
PORT=8000
