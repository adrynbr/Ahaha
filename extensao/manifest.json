{
  "manifest_version": 3,
  "name": "LeadHunter Abridor",
  "version": "1.0.0",
  "description": "Abre as oportunidades do LeadHunter em abas, com a mensagem pronta para você revisar e enviar.",
  "action": { "default_popup": "popup.html", "default_title": "LeadHunter" },
  "background": { "service_worker": "background.js" },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": [
        "https://*.instagram.com/*",
        "https://*.facebook.com/*",
        "https://*.tiktok.com/*",
        "https://x.com/*",
        "https://*.reddit.com/*"
      ],
      "js": ["cartao.js"],
      "run_at": "document_idle"
    }
  ]
}
